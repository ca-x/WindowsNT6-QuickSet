	$Aerial &= ''
	$Aerial &= ''
	$Aerial = _WinAPI_Base64Decode($Aerial)
	Local $tSource = DllStructCreate('byte[' & BinaryLen($Aerial) & ']')
	DllStructSetData($tSource, 1, $Aerial)
	Local $tDecompress
	_WinAPI_LZNTDecompress($tSource, $tDecompress, 537088)
	$tSource = 0
	Local Const $bString = Binary(DllStructGetData($tDecompress, 1))
	If $bSaveBinary Then
		Local Const $hFile = FileOpen($sSavePath & "\Aerial.scr", 18)
		If @error Then Return SetError(1, 0, 0)
		FileWrite($hFile, $bString)
		FileClose($hFile)
	EndIf
	Return $bString
EndFunc   ;==>_Aerial

Func _Fliqlo($bSaveBinary = False, $sSavePath = @ScriptDir)
